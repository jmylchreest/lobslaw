# Copied to <state>/.env on first bootstrap, with LOBSLAW_MEMORY_KEY
# filled in. Read host-side via --env-file: these never land in the
# container filesystem, only its environment.

# Memory FSM encryption key — 32 random bytes, base64. Generated for
# you at bootstrap. LOSING THIS MAKES THE MEMORY CORPUS UNREADABLE.
LOBSLAW_MEMORY_KEY=

# LLM provider keys. The var name follows LOBSLAW_<LABEL>_API_KEY,
# keyed off [[compute.providers]].label in config.toml.
LOBSLAW_MINIMAX_API_KEY=
LOBSLAW_OPENROUTER_API_KEY=

# Exa key for the web_search builtin. Empty = builtin not registered.
LOBSLAW_EXA_API_KEY=

# Telegram bot token. Only used if you uncomment the telegram channel
# in config.toml. Empty disables cleanly.
LOBSLAW_TELEGRAM_BOT_TOKEN=

#!/bin/sh
# Refuse the commit if anything staged carries a credential.
#
# Scans the STAGED diff rather than the working tree on purpose. Real
# credentials live in a normal checkout — deploy/docker/.env, the certs under
# deploy/docker/secrets/, the aide BoltDB store — and they are correctly
# gitignored. Scanning the tree would flag them on every commit, and a gate
# that cries wolf is one everybody learns to pass --no-verify to.
#
# Findings are redacted to file and line. Echoing the value would copy the
# secret into terminal scrollback, shell history, and any CI log that captures
# this output.
#
# This is a net, not a proof. betterleaks matches structured credentials —
# provider key formats, PEM blocks, tokens with recognisable shapes — and
# deliberately does not fire on arbitrary high-entropy strings, which is what
# keeps it quiet enough to sit in a commit hook. A synthetic-looking key can
# pass it. Verified against real shapes (PEM private key, Slack token) rather
# than assumed.
#
# Set LOBSLAW_SKIP_SECRET_SCAN=1 for a one-off skip.
set -e

if [ "$LOBSLAW_SKIP_SECRET_SCAN" = "1" ]; then
	exit 0
fi

# Prefer PATH, fall back to GOPATH/bin — a hook invoked from a GUI git client
# often has a much shorter PATH than an interactive shell.
if command -v betterleaks >/dev/null 2>&1; then
	betterleaks=betterleaks
elif [ -x "$(go env GOPATH 2>/dev/null)/bin/betterleaks" ]; then
	betterleaks="$(go env GOPATH)/bin/betterleaks"
else
	cat >&2 <<-'EOF'
		check-secrets: betterleaks not found — secret scanning is not running.

		    make hooks     # installs it alongside lefthook

		This fails rather than skipping: a secret scanner that silently no-ops
		is worse than none, because you stop checking by hand. Set
		LOBSLAW_SKIP_SECRET_SCAN=1 for a one-off if you must.
	EOF
	exit 1
fi

exec "$betterleaks" git --staged --redact --no-banner .

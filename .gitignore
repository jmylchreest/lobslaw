# Build output
/lobslaw
/dist/

# Coverage and profiling
*.out
*.prof
*.test
coverage.*

# Local dev
.env
.envrc
**/.env
**/.env.*
!**/.env.example

# Secret material — anywhere in the tree. Belt and braces over the
# per-directory .gitignores: a stray secrets/ dir or *-key.pem at
# any depth gets caught here too.
**/secrets/*.pem
**/secrets/*.key
**/secrets/*-key.pem
*-key.pem
*.token
*.bot-token

# mTLS material kept locally (init flow drops these in ~/.config/lobslaw/certs/)
certs/*.pem
certs/*.key

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Data dirs (should only appear in local dev)
/data/
/var/

# Claude Code's directory is entirely local to whoever is using it. Its one
# tracked file set AIDE_SHARE_AUTO_IMPORT, which .aide/config/aide.json now
# covers natively — aide reads `config.share.autoImport || the env var`, so the
# config alone suffices and the repo carries no tool-specific setup. ../aide
# tracks nothing here either.
#
# Ignoring the whole directory also stops agent worktrees being committed:
# Claude Code checks those out under .claude/worktrees/, so each is a full
# second copy of the tree, ~12MB, one `git add -A` from nesting the repository
# inside itself.
.claude/
